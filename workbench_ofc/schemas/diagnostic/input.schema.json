{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apso://schemas/diagnostic/input.schema.json",
  "title": "DiagnosticInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "service_or_ci"],
  "properties": {
    "incident_id": { "type": "string" },
    "service_or_ci": { "type": "string" },
    "symptom_summary": { "type": ["string", "null"] },
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["logs", "change", "infra", "dependency", "app", "code"]
      },
      "description": "Optional subset of subagents to run; empty = all"
    },
    "prior_evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
