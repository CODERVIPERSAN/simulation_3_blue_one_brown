{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apso://schemas/diagnostic/output.schema.json",
  "title": "DiagnosticOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "hypotheses", "confidence", "needs_more_evidence"],
  "properties": {
    "incident_id": { "type": "string" },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "claim", "confidence", "evidence_ids"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "claim": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "subagents_used": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "findings_summary": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_more_evidence": { "type": "boolean" },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
