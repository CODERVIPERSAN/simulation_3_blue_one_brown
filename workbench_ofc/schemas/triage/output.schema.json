{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apso://schemas/triage/output.schema.json",
  "title": "TriageOutput",
  "description": "result.payload from Triage Agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "data_quality",
    "confidence",
    "hitl_required",
    "notes"
  ],
  "properties": {
    "incident_id": { "type": "string" },
    "data_quality": { "type": "string", "enum": ["pass", "fail"] },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "priority": {
      "type": ["string", "null"],
      "enum": ["P1", "P2", "P3", "P4", "P5", null]
    },
    "priority_rationale": { "type": ["string", "null"] },
    "impact_summary": { "type": ["string", "null"] },
    "downstream_services": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "assignment_group": { "type": ["string", "null"] },
    "assigned_to": { "type": ["string", "null"] },
    "ci_id": { "type": ["string", "null"] },
    "business_service": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "hitl_required": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
