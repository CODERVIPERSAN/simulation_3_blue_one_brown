{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apso://schemas/shared/hitl_request.schema.json",
  "title": "HITLRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_request_id",
    "incident_id",
    "gate",
    "summary",
    "packet",
    "requested_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "approval_request_id": { "type": "string", "format": "uuid" },
    "incident_id": { "type": "string" },
    "gate": {
      "type": "string",
      "enum": [
        "priority_escalation",
        "recovery_approach",
        "automation_execution",
        "recovery_confirmation",
        "closure"
      ]
    },
    "channel": {
      "type": "string",
      "enum": ["teams", "email", "ui"],
      "default": "teams"
    },
    "summary": { "type": "string" },
    "packet": {
      "type": "object",
      "description": "Gate-specific facts the human must approve",
      "additionalProperties": true
    },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
